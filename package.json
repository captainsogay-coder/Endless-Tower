{
  "name": "endless-tower",
  "version": "0.3.0",
  "private": true,
  "description": "Endless Tower \u2014 an endless tower-defense game. There is no final wave.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/build.mjs && node server.js dist",
    "test": "node --test tests/*.test.js",
    "sim": "node scripts/simulate.js",
    "ratings": "node scripts/side-tiers.mjs",
    "ratings:check": "node scripts/side-tiers.mjs --check"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "homepage": "https://endlesstower.com"
}
